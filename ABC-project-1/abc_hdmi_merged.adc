# A HDMI pins + B SD pins; KEY1(A2)=next, KEY2(B2)=prev (低有效外部上拉). 无外部复位键.
set_pin_assignment	{ HDMI_CLK_P }	{ LOCATION = C3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_CLK_P1 }	{ LOCATION = K1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D0_P }	{ LOCATION = G5; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D0_P1 }	{ LOCATION = F5; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D1_P }	{ LOCATION = F1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D1_P1 }	{ LOCATION = E3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D2_P }	{ LOCATION = E1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D2_P1 }	{ LOCATION = B3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ led[0] }	{ LOCATION = A4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ led[1] }	{ LOCATION = A3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ led[2] }	{ LOCATION = C10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ led[3] }	{ LOCATION = B12; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ VGA_B[0] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_B[1] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_B[2] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_B[3] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_B[4] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_B[5] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_B[6] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_B[7] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_G[0] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_G[1] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_G[2] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_G[3] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_G[4] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_G[5] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_G[6] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_G[7] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_HS }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_R[0] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_R[1] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_R[2] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_R[3] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_R[4] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_R[5] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_R[6] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_R[7] }	{ LOCATION = virtualIO; }
set_pin_assignment	{ VGA_VS }	{ LOCATION = virtualIO; }
set_pin_assignment	{ sys_clk }	{ LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
# 外部软复位已取消: 原 sys_rst_n=B2 让给 KEY2(向前一张), 运行期只能掉电重新上电冷复位。

# ---- 手动切图按键(低有效, 板上 10K 外部上拉 3V3, 按下接 GND, 串 100R) ----
# 引脚依据: 3_原理图/2_FPGA.pdf BANK3 引脚表 + 6_EX_DEVICE.pdf 4 bit Independent Button:
#   KEY1(K1)=A2 = key_next 向后一张(IMAGE1 -> IMAGE8 循环回绕)
#   KEY2(K2)=B2 = key_prev 向前一张(IMAGE8 -> IMAGE1 循环回绕)
#   KEY3(K3)=B1 提亮、KEY4(K4)=C1 降亮; SW1~SW4 为拨码开关, 不是独立按键。
set_pin_assignment { key_next } { LOCATION = A2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_prev } { LOCATION = B2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_brighter } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { key_dimmer } { LOCATION = C1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- 自动轮播拨码档位(低有效, RN38 120R 串阻, 板上 PULLUP; 拨上=0 选中) ----
# 引脚依据: 3_原理图/2_FPGA.pdf BANK3 引脚表 SWKEY1~SWKEY4:
#   SW1(C8) = sw1_n = 1 秒自动切图
#   SW2(C7) = sw2_n = 3 秒自动切图
#   SW3(C6) = sw3_n = 5 秒自动切图
#   SW4(C5) = sw4_n = 8 秒。多档同时选中优先SW1、SW2、SW3、SW4；全拨下=纯手动。
set_pin_assignment { sw1_n } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { sw2_n } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { sw3_n } { LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { sw4_n } { LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }


set_pin_assignment { SD_DCLK } { LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { SD_MISO } { LOCATION = B14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { SD_MOSI } { LOCATION = A13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { SD_nCS } { LOCATION = A12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# HDMI audio reference DDC pins (fixed video/audio format).
set_pin_assignment { HDMI_DDC_SCL } { LOCATION = P2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { HDMI_DDC_SDA } { LOCATION = R2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
